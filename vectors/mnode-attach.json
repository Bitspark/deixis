      "parent": ["6b"], "key": "6c",
      "B": { "own": { "class": "b", "representation": "b" }, "children": [] },
      "result": { "defined": { "own": { "class": "r", "representation": "r" }, "children": [["6b", { "own": { "class": "i", "representation": "i" }, "children": [["6a", { "own": { "class": "t", "representation": "t" }, "children": [] }], ["6c", { "own": { "class": "b", "representation": "b" }, "children": [] }]] }], ["61", { "own": { "class": "s", "representation": "s" }, "children": [] }]] } },
      "note": "X14. The interior node [6b] keeps its value i and its existing child [6a], and gains [6c]."
    },
    {
      "name": "m-attach-at-terminal-valued-node",
      "slot": "fixture", "op": "attach",
      "A": { "own": { "class": "r", "representation": "r" }, "children": [["61", { "own": { "class": "s", "representation": "s" }, "children": [] }]] },
      "parent": ["61"], "key": "61",
      "B": { "own": { "class": "b", "representation": "b" }, "children": [] },
      "result": { "defined": { "own": { "class": "r", "representation": "r" }, "children": [["61", { "own": { "class": "s", "representation": "s" }, "children": [["61", { "own": { "class": "b", "representation": "b" }, "children": [] }]] }]] } },
      "note": "X14. A childless node carrying s gains a child and keeps s at the same path. This is the availability that separates the product models from Leaf | Struct (TREE, Growth). The key 61 repeats its parent's key, which is legal: the new path [61,61] is fresh."
