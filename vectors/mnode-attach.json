      "result": { "undefined": {} },
      "note": "X14. B equals the occupant, but the domain condition r ∉ D_A still fails. Attachment never compares payloads (§5) and is not an upsert. Catches W10."
    },
    {
      "name": "m-attach-empty-key-is-fresh",
      "slot": "fixture", "op": "attach",
      "A": { "own": { "class": "r", "representation": "r" }, "children": [["61", { "own": { "class": "s", "representation": "s" }, "children": [] }]] },
