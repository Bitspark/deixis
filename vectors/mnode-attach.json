      "slot": "fixture", "op": "attach",
      "A": { "own": { "class": "r", "representation": "r" }, "children": [["6b", { "own": { "class": "i", "representation": "i" }, "children": [["6a", { "own": { "class": "t", "representation": "t" }, "children": [] }]] }], ["61", { "own": { "class": "s", "representation": "s" }, "children": [] }]] },
      "parent": [], "key": "62",
      "B": { "own": { "class": "b", "representation": "b" }, "children": [] },
      "result": { "defined": { "own": { "class": "r", "representation": "r" }, "children": [["6b", { "own": { "class": "i", "representation": "i" }, "children": [["6a", { "own": { "class": "t", "representation": "t" }, "children": [] }]] }], ["61", { "own": { "class": "s", "representation": "s" }, "children": [] }], ["62", { "own": { "class": "b", "representation": "b" }, "children": [] }]] } },
      "note": "X14. p = ε exists and [62] is fresh. The new tree adds exactly the path [62] with B's value; the root value r is unchanged."
    },
    {
      "name": "m-attach-at-interior-valued-parent",
      "slot": "fixture", "op": "attach",
