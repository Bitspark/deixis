# Source stays LF in every checkout, so gofmt -l, cargo fmt, ruff, diffs and the conformance
# harness's byte comparisons mean the same thing on Windows and Linux.
* text=auto eol=lf
*.go text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.txt text eol=lf

# The corpus the four cores are compared against byte for byte. A CRLF here would make one
# core disagree with the others on a checkout, which is exactly the failure this repository
# exists to detect, and it would be an artefact, not a real one.
vectors/** text eol=lf

*.pdf binary
